.tab-bar {
  display: flex;
  flex-direction: row;
  position: fixed;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  height: 104rpx;
  background: var(--glass-bg-strong);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: 36rpx;
  padding: 8rpx 12rpx;
  box-shadow: 0 10rpx 40rpx rgba(31, 64, 104, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0 4rpx;
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
}

.tab-bar-item-active {
  color: var(--primary);
}

.tab-bar-active-glow {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 4rpx;
  bottom: 4rpx;
  z-index: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.16), rgba(92, 196, 255, 0.08));
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7), 0 5rpx 16rpx rgba(0, 102, 204, 0.12);
  animation: tabGlowEnter 0.3s var(--motion-ease-out) both;
}

.tab-bar-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.tab-bar-icon {
  transition: transform 0.2s ease;
}

.tab-bar-item-active .tab-bar-icon {
  animation: tabIconSettle 0.38s var(--motion-ease-spring) both;
}

.tab-bar-badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF4D4F);
  border-radius: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 79, 0.4);
  border: 2rpx solid #FFFFFF;
}

.tab-bar-badge-text {
  font-size: 18rpx;
  color: #FFFFFF;
}

.tab-bar-text {
  font-size: 20rpx;
  color: #9aa3b2;
  line-height: 1.2;
  transition: color 0.2s ease, font-weight 0.2s ease;
  position: relative;
  z-index: 1;
}

.tab-bar-item-active .tab-bar-text {
  color: var(--primary);
  font-weight: 700;
}

@keyframes tabGlowEnter {
  0% { opacity: 0; transform: scaleX(0.68) scaleY(0.82); }
  70% { opacity: 1; transform: scaleX(1.04) scaleY(1); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes tabIconSettle {
  0% { opacity: 0.55; transform: translateY(8rpx) scale(0.82); }
  65% { opacity: 1; transform: translateY(-3rpx) scale(1.1); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.filter-panel{padding:22rpx;background:#fff;border:2rpx solid #e8eef6;border-radius:22rpx;margin-bottom:22rpx}.filter-search{display:flex;align-items:center;gap:14rpx;background:#f3f7fc;border-radius:14rpx;padding:0 22rpx;min-height:84rpx}.filter-search input{flex:1;font-size:27rpx;min-width:0}.search-mark{color:#7890ad;font-size:30rpx}.filter-row{display:flex;gap:14rpx;margin-top:16rpx}.filter-row picker{flex:1;min-width:0}.filter-select{min-height:84rpx;display:flex;align-items:center;justify-content:space-between;padding:0 22rpx;background:#f5f8fc;border:2rpx solid #e2eaf5;border-radius:14rpx;color:#31516e;font-size:26rpx;gap:12rpx}.filter-select text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.result-caption{display:flex;justify-content:space-between;font-size:23rpx;color:#7d8ba0;margin:22rpx 4rpx}.management-card{background:#fff;border:2rpx solid #e4ecf6;border-radius:22rpx;padding:28rpx;margin-bottom:18rpx}.management-title{display:block;font-size:32rpx;font-weight:700;color:#173451;margin-bottom:14rpx}.management-note{display:block;font-size:25rpx;color:#728398;line-height:1.8}.management-row{display:flex;justify-content:space-between;gap:24rpx;margin:16rpx 0;font-size:27rpx;line-height:1.65}.management-label{color:#8290a3;flex-shrink:0}.management-value{color:#294762;text-align:right;word-break:break-all}.management-actions{display:flex;gap:14rpx;margin-top:24rpx}.management-actions button{flex:1;margin:0;min-height:88rpx;font-size:27rpx}.status-counselor_only{color:#855b17;background:#fff6e6}.detail-link{display:block;color:#0869c7;font-size:25rpx;margin-top:20rpx}.management-state{padding:36rpx;text-align:center;background:#fff;border-radius:22rpx;color:#738499;font-size:27rpx}.management-page{padding:28rpx;box-sizing:border-box;min-height:100vh}

.detail-card {
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  margin: 24rpx;
  border-radius: var(--radius-lg);
  padding: 32rpx;
}

.detail-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.detail-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background-size: 44rpx 44rpx, 100% 100%;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5), 0 8rpx 18rpx rgba(31, 64, 104, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.detail-title {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.3;
}

.detail-number {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.detail-status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-open {
  color: var(--success);
  background: var(--success-light);
}

.status-closed {
  color: var(--danger);
  background: var(--danger-light);
}

.detail-info {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F7F8FA;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
  text-align: right;
}

.detail-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border-color);
}

.section-label {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.device-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.device-tag {
  font-size: 24rpx;
  color: var(--primary);
  background-color: var(--primary-light);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-sm);
}

.rules-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 24rpx 40rpx;
}

.action-btn {
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.btn-group {
  color: #5B3CC4;
  background: linear-gradient(135deg, #F2EDFF, #E8DFFF);
  border: 2rpx solid #D7C8FF;
  font-weight: 800;
}

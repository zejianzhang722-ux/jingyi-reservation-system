@import "../../styles/admin-management.wxss";
.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.page-header { padding: 8rpx 4rpx 24rpx; }
.title { display: block; font-size: 38rpx; font-weight: 800; color: #172033; }
.subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: #7b8794; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.tab { display: flex; flex: 1; align-items: center; justify-content: center; min-height: var(--btn-h-md); text-align: center; background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); color: #647084; border-radius: 14rpx; padding: 0; font-size: var(--btn-font-sm); box-shadow: var(--glass-shadow); }
.tab.active { background: var(--btn-primary-bg); color: #fff; font-weight: 700; }
.action-strip { display: flex; justify-content: space-between; gap: 20rpx; align-items: center; background: #edf5ff; color: #52627a; border-radius: 14rpx; padding: 20rpx 22rpx; font-size: 24rpx; margin-bottom: 18rpx; }
.link { color: var(--btn-primary-bg); font-weight: 700; flex-shrink: 0; }
.list-card { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); border-radius: 16rpx; overflow: hidden; box-shadow: var(--glass-shadow); }
.list-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #eef1f5; }
.list-item:last-child { border-bottom: 0; }
.item-main { flex: 1; min-width: 0; }
.item-title { display: block; font-size: 30rpx; font-weight: 700; color: #172033; }
.item-desc { display: block; margin-top: 8rpx; font-size: 24rpx; color: #647084; }
.item-time { display: block; margin-top: 6rpx; font-size: 22rpx; color: #99a3b3; }
.score { font-size: 32rpx; font-weight: 800; margin-left: 20rpx; }
.danger { color: var(--btn-danger-bg); }
/* 解除按钮在 flex 行内需固定不压缩 */
.list-action { flex-shrink: 0; margin-left: 20rpx; }
.config-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; padding: 22rpx 24rpx; border-bottom: 1rpx solid #eef1f5; }
.config-row:last-child { border-bottom: 0; }
.config-key { flex: 0 0 260rpx; font-size: 24rpx; color: #647084; }
.config-value { flex: 1; text-align: right; font-size: 24rpx; color: #172033; word-break: break-all; }
.empty { text-align: center; color: #99a3b3; font-size: 26rpx; padding: 90rpx 0; }
.search-button{margin:0;padding:0 12rpx;min-height:76rpx;line-height:76rpx;background:transparent;color:#0766c9;font-size:25rpx}.search-button::after{border:0}.setting-button{flex-shrink:0;min-width:180rpx;margin:0}.credit-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.credit-detail-button{margin-top:20rpx;width:100%;min-height:80rpx;font-size:25rpx}.management-actions button{font-size:24rpx;padding:0 12rpx}

<view class="container motion-page motion-stack">
  <view class="header"><text class="title">功能房管理</text><text class="subtitle">查看空间信息、使用安排与管理选项</text></view>
  <view class="filter-panel">
    <view class="filter-search"><text class="search-mark">⌕</text><input placeholder="搜索房间名称、位置" value="{{keyword}}" bindinput="onSearch" /></view>
    <view class="filter-row">
      <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="filter-select"><text>{{typeOptions[typeIndex].label}}</text><text>⌄</text></view></picker>
      <picker range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange"><view class="filter-select"><text>{{statusOptions[statusIndex].label}}</text><text>⌄</text></view></picker>
    </view>
    <view class="result-caption" wx:if="{{filterStatusLabel}}"><text>当前查看：{{filterStatusLabel}}</text><text class="detail-link" bindtap="onClearStatus">查看全部状态</text></view>
  </view>
  <view class="result-caption"><text>共 {{visibleRooms.length}} 个空间</text><text>点击卡片查看管理详情</text></view>
  <view class="room-list" wx:if="{{visibleRooms.length > 0}}">
    <view class="room-item" wx:for="{{visibleRooms}}" wx:key="id" data-id="{{item.id}}" bindtap="onViewDetail">
      <view class="room-info"><view class="room-header"><text class="room-name">{{item.name}}</text><text class="room-status status-{{item.status}}">{{statusMap[item.status] || '状态待确认'}}</text></view>
      <view class="room-detail"><text class="detail-text">{{typeMap[item.type] || '其他空间'}} · {{item.location || item.building_name || '-'}}</text><text class="detail-text">容量 {{item.capacity || '-'}} 人 · {{item.open_start_time || '-'}}–{{item.open_end_time || '-'}}</text></view>
      <text class="detail-link">管理详情 →</text></view>
    </view>
  </view>
  <view class="management-state" wx:else>没有符合筛选条件的空间</view>
</view>

<view class="container">
  <view class="header">
    <text class="title">全部预约</text>
    <view class="search-bar">
      <input class="search-input" placeholder="搜索用户/房间" value="{{keyword}}" bindinput="onSearch" placeholder-style="color:#999" />
    </view>
  </view>
  <view class="filter-tabs" wx:if="{{filterLabel}}">
    <text class="tab active">当前查看：{{filterLabel}}</text>
    <view class="tab" bindtap="onClearPreset" aria-role="button" aria-label="清除当前筛选">查看全部</view>
  </view>
  <view class="filter-tabs">
    <view class="tab {{!filterPreset && filterStatus === '' ? 'active' : ''}}" bindtap="onFilter" data-status="">全部</view>
    <view class="tab {{!filterPreset && filterStatus === 'pending' ? 'active' : ''}}" bindtap="onFilter" data-status="pending">待审批</view>
    <view class="tab {{!filterPreset && filterStatus === 'approved' ? 'active' : ''}}" bindtap="onFilter" data-status="approved">已通过</view>
    <view class="tab {{!filterPreset && filterStatus === 'rejected' ? 'active' : ''}}" bindtap="onFilter" data-status="rejected">已拒绝</view>
    <view class="tab {{!filterPreset && filterStatus === 'checked_in' ? 'active' : ''}}" bindtap="onFilter" data-status="checked_in">使用中</view>
    <view class="tab {{!filterPreset && filterStatus === 'completed' ? 'active' : ''}}" bindtap="onFilter" data-status="completed">已完成</view>
  </view>
  <view class="reservation-list" wx:if="{{list.length > 0}}">
    <view class="reservation-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onViewDetail">
      <view class="item-top">
        <text class="item-user">{{item.userName || item.user_name || '未知'}}</text>
        <text class="item-status status-{{item.status}}">{{statusMap[item.status] || item.status}}</text>
      </view>
      <view class="item-info">
        <text class="info-row">房间: {{item.roomName || item.room_name || '-'}}</text>
        <text class="info-row">日期: {{item.date || '-'}}</text>
        <text class="info-row">时间: {{item.startTime || item.start_time || '-'}} - {{item.endTime || item.end_time || '-'}}</text>
      </view>
      <view class="detail-hint" wx:if="{{item.status === 'counselor_pending'}}">查看并审核</view>
      <view class="item-actions" wx:if="{{item.canQuickAudit}}" catchtap="">
        <text wx:if="{{processingById[item.id]}}">处理中</text>
        <block wx:else>
          <view class="btn-approve" data-id="{{item.id}}" catchtap="onApprove">通过</view>
          <view class="btn-reject" data-id="{{item.id}}" catchtap="onReject">拒绝</view>
        </block>
      </view>
    </view>
  </view>
  <view class="empty" wx:else><text>暂无预约记录</text></view>
  <view class="load-more" wx:if="{{hasMore && list.length > 0}}" bindtap="onLoadMore"><text>加载更多</text></view>
</view>

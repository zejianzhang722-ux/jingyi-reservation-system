.container { padding: 20rpx 30rpx; min-height: 100vh; }
.header { padding: 20rpx 0; }
.title { font-size: 36rpx; font-weight: 700; color: #1a1a2e; display: block; margin-bottom: 20rpx; }
.filter-tabs { display: flex; gap: 12rpx; flex-wrap: wrap; }
.tab { display: flex; align-items: center; justify-content: center; min-height: var(--btn-h-md); padding: 0 var(--btn-px-sm); font-size: var(--btn-font-sm); color: #666; background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border-radius: 30rpx; border: 1rpx solid var(--glass-border); }
.tab.active { background: var(--btn-primary-bg); color: #fff; border-color: var(--btn-primary-bg); }
.reservation-list { margin-top: 20rpx; }
.reservation-item { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); box-shadow: var(--glass-shadow); border-radius: 16rpx; padding: 24rpx 30rpx; margin-bottom: 16rpx; }
.item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.item-user { font-size: 28rpx; font-weight: 500; color: #333; }
.item-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.item-status.pending { color: var(--warning); background: var(--warning-light); }
.item-status.approved { color: var(--success); background: var(--success-light); }
.item-status.rejected { color: var(--danger); background: var(--danger-light); }
.item-status.cancelled { color: #999; background: #f5f5f5; }
.info-row { display: block; font-size: 24rpx; color: #666; line-height: 1.8; }
.item-actions { display: flex; gap: 16rpx; margin-top: 16rpx; justify-content: flex-end; }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }
/* 加载更多：接入统一按钮层，min-height 走 --btn-h-md 保证触控区 */
.load-more { display: flex; align-items: center; justify-content: center; margin: 24rpx 0 8rpx; }

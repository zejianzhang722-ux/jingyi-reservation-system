.profile-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  padding: 48rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.profile-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  opacity: 0.6;
}

.profile-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.avatar-choose-button {
  padding: 0;
  margin: 0;
  line-height: 1;
}

.avatar-choose-button::after {
  border: 0;
}

.profile-avatar-icon {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.profile-avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #E8F4FF, #B9DAFF);
  color: #0052A3;
  font-size: 46rpx;
  font-weight: 800;
}

.profile-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.profile-avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.profile-avatar-edit::before,
.profile-avatar-edit::after {
  content: '';
  position: absolute;
  background: #ffffff;
  border-radius: 4rpx;
}

.profile-avatar-edit::before {
  width: 18rpx;
  height: 6rpx;
  transform: rotate(-38deg);
}

.profile-avatar-edit::after {
  width: 6rpx;
  height: 6rpx;
  right: 8rpx;
  top: 10rpx;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  letter-spacing: 1rpx;
}

.profile-student-id {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
  display: block;
}

.profile-credit {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 28rpx;
  position: relative;
  animation: pulseGlow 3s ease-in-out infinite;
}

.credit-score {
  font-size: 44rpx;
  font-weight: 700;
}

.credit-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.profile-credit-bar {
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  padding: 24rpx 32rpx;
  margin: 16rpx 24rpx;
  border-radius: 24rpx;
}

.credit-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.4);
  border: 1rpx solid var(--glass-border-soft);
  border-radius: 8rpx;
  overflow: hidden;
}

.credit-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.credit-bar-labels {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 8rpx;
}

.credit-bar-label {
  font-size: 20rpx;
}

.menu-list {
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  margin: 16rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background-color 0.2s ease;
}

.menu-item:active {
  background-color: var(--accent-light);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.menu-icon-wrap {
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7), 0 4rpx 12rpx rgba(31, 64, 104, 0.08);
}

.menu-icon-blue { background: linear-gradient(145deg, rgba(0, 102, 204, 0.14), rgba(0, 102, 204, 0.05)); }
.menu-icon-gold { background: linear-gradient(145deg, rgba(240, 170, 32, 0.18), rgba(240, 170, 32, 0.06)); }
.menu-icon-green { background: linear-gradient(145deg, rgba(47, 138, 59, 0.16), rgba(47, 138, 59, 0.05)); }
.menu-icon-cyan { background: linear-gradient(145deg, rgba(15, 181, 181, 0.16), rgba(15, 181, 181, 0.05)); }
.menu-icon-purple { background: linear-gradient(145deg, rgba(139, 92, 246, 0.16), rgba(139, 92, 246, 0.05)); }
.menu-icon-gray { background: linear-gradient(145deg, rgba(105, 115, 134, 0.14), rgba(105, 115, 134, 0.04)); }
.menu-icon-red { background: linear-gradient(145deg, rgba(214, 69, 69, 0.18), rgba(214, 69, 69, 0.06)); }

.menu-icon-inner {
  width: 34rpx;
  height: 34rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #333333;
}

.menu-arrow-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

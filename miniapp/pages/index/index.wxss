.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  padding: 32rpx 32rpx 40rpx;
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  opacity: 0.6;
}

.header-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-brand {
  display: flex;
  flex-direction: column;
}

.header-logo {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.header-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
  letter-spacing: 2rpx;
}

.header-user {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 40rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  transition: background-color 0.2s ease;
}

.header-user:active {
  background: rgba(255, 255, 255, 0.25);
}

.header-avatar-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.header-avatar-icon {
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}

.header-user-info {
  display: flex;
  flex-direction: column;
}

.header-name {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
  line-height: 1.3;
}

.header-credit {
  font-size: 20rpx;
  margin-top: 2rpx;
  opacity: 0.9;
}

.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 44rpx;
  padding: 20rpx 28rpx;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.search-icon-wrap {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-icon-svg {
  width: 32rpx;
  height: 32rpx;
}

.search-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #BBBBBB;
}

.search-keyword {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  padding: 32rpx 32rpx 16rpx;
  letter-spacing: 1rpx;
  position: relative;
}

.quick-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 20rpx 24rpx 8rpx;
}

.quick-item {
  min-height: 112rpx;
  padding: 18rpx 12rpx;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.quick-num {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--primary);
  line-height: 1.2;
}

.quick-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: var(--accent);
  border-radius: 3rpx;
  margin-right: 12rpx;
  vertical-align: middle;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 12rpx;
  padding: 0 24rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
}

.category-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 3rpx;
  background: var(--accent);
  border-radius: 0 0 3rpx 3rpx;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.category-item:active {
  transform: scale(0.96);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.category-item-active {
  box-shadow: 0 4rpx 16rpx rgba(0, 102, 204, 0.15);
}

.category-item-active::before {
  opacity: 1;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 12rpx;
  transition: transform 0.2s ease;
  box-shadow: 0 10rpx 20rpx rgba(31, 64, 104, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.category-item:active .category-icon {
  transform: scale(1.08);
}

.category-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background-color: #FF4D4F;
  border-radius: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border: 2rpx solid #FFFFFF;
}

.category-badge-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.category-name {
  font-size: 24rpx;
  color: #333333;
  font-weight: 600;
  margin-top: 4rpx;
  line-height: 1.3;
}

.category-count {
  font-size: 20rpx;
  color: #999999;
  margin-top: 2rpx;
}

.empty-category {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.3s ease-out both;
}


.empty-text {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCCCCC;
}

.offline-tip {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background-color: #FFF7E6;
  border-radius: 12rpx;
  border: 1rpx solid #FFE58F;
  gap: 12rpx;
}

.offline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #FA8C16;
  flex-shrink: 0;
}

.offline-text {
  font-size: 24rpx;
  color: #D48806;
  line-height: 1.4;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  animation: fadeIn 0.3s ease-out both;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

.announcement-bar {
  display: flex;
  align-items: center;
  margin: 12rpx 24rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF8E1, #FFF3E0);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.1);
}

.announcement-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: var(--accent);
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.announcement-scroll {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

.announcement-text {
  font-size: 26rpx;
  color: #E65100;
  display: inline-block;
  animation: announcement-scroll 15s linear infinite;
}

@keyframes announcement-scroll {
  0% { transform: translateX(100%); }
  100% { transform: translateX(-100%); }
}

<view class="container motion-page motion-detail">
  <view class="rules-card" wx:if="{{!loading}}">
    <view class="rules-header" wx:if="{{typeName}}">
      <view class="rules-type-icon rules-type-icon-{{type || 'reading'}}"></view>
      <text class="rules-type-name">{{typeName}}管理制度</text>
    </view>
    <view class="rules-content">
      <view class="rule-section" wx:for="{{rulesSections}}" wx:key="index" wx:for-item="section"><text class="rule-section-title" wx:if="{{section.title}}">{{section.title}}</text><view class="rule-point" wx:for="{{section.items}}" wx:key="index" wx:for-item="point"><text class="rule-point-dot">•</text><text>{{point}}</text></view></view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>

@import "../../styles/rules-content.wxss";
.rules-card {
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  margin: 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.rules-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.45);
  border-bottom: 1rpx solid var(--glass-border-soft);
  gap: 12rpx;
}

.rules-type-icon {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid #1677D2;
  border-left-width: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.rules-type-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.rules-content {
  padding: 32rpx 24rpx;
}

.rules-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 2;
  white-space: pre-wrap;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

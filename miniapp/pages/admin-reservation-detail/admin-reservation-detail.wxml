<view class="page">
  <view class="state-card" wx:if="{{pageStatus === 'loading'}}" aria-role="status" aria-label="预约详情加载中">
    <text class="state-title">详情加载中</text><text class="state-desc">正在获取最新预约与申请人信息</text>
  </view>
  <view class="state-card error-card" wx:elif="{{pageStatus === 'error'}}" aria-role="alert">
    <text class="state-title">加载失败</text><text class="state-desc">{{errorMessage}}</text>
    <button class="retry-button" bindtap="onRetry" aria-role="button" aria-label="重新加载预约详情">重新加载</button>
  </view>
  <block wx:elif="{{pageStatus === 'ready' && reservation}}">
    <view class="summary-card">
      <view class="summary-top"><view><text class="eyebrow">预约 #{{reservation.id}}</text><text class="room-name">{{reservation.roomName}}</text></view><text class="status-tag {{reservation.isPriority ? 'priority' : ''}}">{{reservation.statusLabel}}</text></view>
      <view class="priority-note" wx:if="{{reservation.isPriority}}"><text class="priority-title">重点审批说明</text><text class="priority-text">该预约需由辅导员或超级管理员在详情页完成审核。</text></view>
      <view class="priority-note ordinary-note" wx:elif="{{reservation.status === 'pending'}}"><text class="priority-title">普通待审说明</text><text class="priority-text">请核对预约时段、用途和人数，确认无冲突后再完成审核。</text></view>
    </view>
    <view class="detail-card">
      <text class="section-title">申请人</text>
      <view class="detail-row"><text class="label">姓名</text><text class="value">{{reservation.userName}}</text></view>
      <view class="detail-row"><text class="label">学号</text><text class="value">{{reservation.studentId}}</text></view>
      <view class="detail-row"><text class="label">信用分</text><text class="value credit-value">{{reservation.credit_score}}</text></view>
      <view class="detail-row"><text class="label">账号状态</text><text class="value">{{reservation.userStatusLabel}}</text></view>
    </view>
    <view class="detail-card">
      <text class="section-title">预约信息</text>
      <view class="detail-row"><text class="label">用途</text><text class="value">{{reservation.purpose}}</text></view>
      <view class="detail-row"><text class="label">人数</text><text class="value">{{reservation.participants}} 人</text></view>
      <view class="detail-row"><text class="label">楼栋</text><text class="value">{{reservation.buildingLabel}}</text></view>
      <view class="detail-row"><text class="label">空间类型</text><text class="value">{{reservation.roomTypeLabel}}</text></view>
      <view class="detail-row"><text class="label">日期</text><text class="value">{{reservation.date}}</text></view>
      <view class="detail-row"><text class="label">时间</text><text class="value">{{reservation.timeSlot}}</text></view>
      <view class="detail-row" wx:if="{{reservation.createdAt}}"><text class="label">提交时间</text><text class="value">{{reservation.createdAt}}</text></view>
      <view class="detail-row" wx:if="{{reservation.rejectReason}}"><text class="label">拒绝原因</text><text class="value">{{reservation.rejectReason}}</text></view>
    </view>
  </block>
  <view class="action-bar" wx:if="{{pageStatus === 'ready' && reservation && (canApprove || canReject)}}">
    <button class="action-button reject-button" disabled="{{processing}}" bindtap="onReject" aria-role="button" aria-label="拒绝预约">{{processing ? '处理中' : '拒绝'}}</button>
    <button class="action-button approve-button" disabled="{{processing}}" bindtap="onApprove" aria-role="button" aria-label="通过预约">{{processing ? '处理中' : '通过'}}</button>
  </view>
</view>
.container { padding: 20rpx 30rpx; min-height: 100vh; }
.header { padding: 20rpx 0; }
.title { font-size: 36rpx; font-weight: 700; color: #1a1a2e; display: block; margin-bottom: 20rpx; }
.filter-tabs { display: flex; gap: 16rpx; }
.tab { display: flex; align-items: center; justify-content: center; min-height: var(--btn-h-md); padding: 0 var(--btn-px-sm); font-size: var(--btn-font-sm); color: #666; background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border-radius: 30rpx; border: 1rpx solid var(--glass-border); }
.tab.active { background: var(--btn-primary-bg); color: #fff; border-color: var(--btn-primary-bg); }
.feedback-list { margin-top: 20rpx; }
.feedback-item { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); box-shadow: var(--glass-shadow); border-radius: 16rpx; padding: 24rpx 30rpx; margin-bottom: 16rpx; }
.item-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.item-user { font-size: 28rpx; font-weight: 500; color: #333; }
.item-type { font-size: 22rpx; color: var(--btn-primary-bg); background: #e6f7ff; padding: 4rpx 12rpx; border-radius: 6rpx; }
.item-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.item-status.pending { color: var(--warning); background: var(--warning-light); }
.item-status.resolved { color: var(--success); background: var(--success-light); }
.item-content { font-size: 26rpx; color: #666; line-height: 1.6; display: block; margin-bottom: 16rpx; }
.item-footer { display: flex; justify-content: space-between; align-items: center; }
.item-time { font-size: 22rpx; color: #999; }
/* 操作区：按钮等宽并排（高度/字号由 ui-btn 提供，此处只补布局） */
.item-actions { display: flex; flex-shrink: 0; gap: var(--btn-gap-sm); }
.item-actions .ui-btn { margin: 0; }
/* 回复表单：此前 reply 相关 class 无任何样式规则，此处补齐基础版式 */
.reply-form { margin-top: 20rpx; }
.reply-input { box-sizing: border-box; width: 100%; min-height: 140rpx; padding: 18rpx; border: 1rpx solid var(--glass-border); border-radius: var(--btn-radius); background: rgba(255, 255, 255, 0.72); font-size: 26rpx; }
.reply-btns { display: flex; gap: var(--btn-gap); margin-top: 18rpx; }
.reply-btns .ui-btn { flex: 1; }
.reply-label { font-size: 24rpx; color: #667085; }
.reply-content { font-size: 26rpx; color: #333; }
.item-reply { margin-bottom: 16rpx; padding: 16rpx 20rpx; border-left: 6rpx solid var(--btn-primary-bg); border-radius: 10rpx; background: rgba(0, 102, 204, 0.06); }
.empty { text-align: center; padding: 100rpx 0; color: #999; font-size: 28rpx; }

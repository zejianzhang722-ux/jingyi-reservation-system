.confirm-card {
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
  margin: 24rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.confirm-section {
  padding: 28rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.confirm-section:last-of-type {
  border-bottom: none;
}

.confirm-section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 18rpx;
  display: block;
}

.summary-section {
  background: linear-gradient(135deg, rgba(0, 102, 204, 0.06), rgba(255, 255, 255, 0.35));
}

.summary-room {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.summary-name {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary);
}

.summary-time {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-item {
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-md);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.summary-value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 700;
}

.confirm-row,
.confirm-input-row,
.confirm-switch-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 78rpx;
  border-top: 1rpx solid #F7F8FA;
}

.confirm-row:first-of-type,
.confirm-input-row:first-of-type,
.confirm-switch-row:first-of-type {
  border-top: none;
}

.confirm-label {
  font-size: 27rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
  width: 170rpx;
}

.required-star {
  color: #FF4D4F;
  margin-right: 4rpx;
}

.confirm-value {
  font-size: 27rpx;
  color: var(--text-primary);
  flex: 1;
  text-align: right;
  font-weight: 600;
}

.placeholder {
  color: var(--text-hint);
  font-weight: 400;
}

.confirm-input {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  color: var(--text-primary);
  padding: 10rpx 0;
}

.confirm-agree {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 28rpx;
  border-top: 1rpx solid var(--border-color);
}

.agree-check {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--disabled);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox-checked {
  background-color: var(--primary);
  border-color: var(--primary);
}

.checkbox-checked::after {
  content: '';
  width: 16rpx;
  height: 8rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.agree-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.agree-link {
  font-size: 26rpx;
  color: var(--primary);
  margin-left: 4rpx;
  font-weight: 700;
}

.submit-btn {
  margin: 32rpx 24rpx;
  padding: 28rpx;
  text-align: center;
  border-radius: var(--radius-md);
  font-size: 32rpx;
  font-weight: 800;
}

.reservation-mode-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.reservation-mode {
  padding: 22rpx 18rpx;
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-md);
  background: #FAFBFC;
}

.reservation-mode-active {
  border-color: var(--primary);
  background: var(--primary-light);
  box-shadow: 0 8rpx 22rpx rgba(0, 102, 204, 0.12);
}

.reservation-mode-group.reservation-mode-active {
  border-color: #7657D6;
  background: #F2EDFF;
  box-shadow: 0 8rpx 22rpx rgba(91, 60, 196, 0.14);
}

.reservation-mode-title,
.reservation-mode-desc {
  display: block;
}

.reservation-mode-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 800;
}

.reservation-mode-desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.group-description-row {
  align-items: flex-start;
  padding-top: 18rpx;
}

.confirm-textarea {
  flex: 1;
  min-height: 120rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-sm);
  background: #F7F8FA;
  color: var(--text-primary);
  font-size: 26rpx;
  box-sizing: border-box;
}

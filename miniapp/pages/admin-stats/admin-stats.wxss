.container { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.page-header { padding: 8rpx 4rpx 24rpx; }
.title { display: block; font-size: 38rpx; font-weight: 800; color: #172033; }
.subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: #7b8794; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-bottom: 24rpx; }
.stat-card { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); border-radius: 16rpx; padding: 28rpx; box-shadow: var(--glass-shadow); }
.stat-card.warning .stat-value { color: var(--btn-danger-bg); }
.stat-value { display: block; font-size: 46rpx; font-weight: 800; color: var(--btn-primary-bg); }
.stat-label { display: block; margin-top: 6rpx; font-size: 24rpx; color: #7b8794; }
.section { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); border-radius: 16rpx; padding: 24rpx; margin-bottom: 22rpx; box-shadow: var(--glass-shadow); }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #172033; }
.refresh-button { flex-shrink: 0; margin: -12rpx -20rpx -12rpx 0; }
.rank-row, .simple-row, .summary-line { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eef1f5; }
.rank-row:last-child, .simple-row:last-child { border-bottom: 0; }
.rank-info { flex: 1; min-width: 0; }
.rank-name { display: block; font-size: 28rpx; color: #1f2a3d; font-weight: 600; }
.rank-meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8a94a6; }
.summary-value { color: var(--btn-primary-bg); font-size: 30rpx; font-weight: 800; margin-left: 20rpx; }
.danger { color: var(--btn-danger-bg); }
.empty { text-align: center; color: #99a3b3; font-size: 26rpx; padding: 36rpx 0; }
.state-card { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); border-radius: 16rpx; padding: 56rpx 32rpx; text-align: center; box-shadow: var(--glass-shadow); }
.state-title { display: block; color: #172033; font-size: 30rpx; font-weight: 700; }
.state-message { display: block; margin-top: 12rpx; color: #7b8794; font-size: 24rpx; line-height: 1.6; }
.error-state .state-title { color: var(--btn-danger-bg); }
.retry-button { width: 100%; margin-top: 28rpx; }

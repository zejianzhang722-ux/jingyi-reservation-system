<view class="container">
  <view class="page-header">
    <text class="title">数据统计</text>
    <text class="subtitle">查看当前职责范围内的预约、使用、爽约和信用概况</text>
  </view>

  <view class="state-card" wx:if="{{pageStatus === 'loading'}}">
    <text class="state-title">正在加载统计数据</text>
    <text class="state-message">请稍候</text>
  </view>

  <view class="state-card error-state" wx:elif="{{pageStatus === 'error'}}">
    <text class="state-title">加载失败</text>
    <text class="state-message">{{errorMessage}}</text>
    <button class="retry-button" bindtap="onRetry" aria-label="重新加载统计数据">重新加载</button>
  </view>

  <block wx:else>
    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{dashboard.todayReservations}}</text>
        <text class="stat-label">今日预约</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{dashboard.ordinaryPendingCount}}</text>
        <text class="stat-label">普通待审</text>
      </view>
      <view class="stat-card warning" wx:if="{{showCounselorPending}}">
        <text class="stat-value">{{dashboard.counselorPendingCount}}</text>
        <text class="stat-label">重点待审</text>
      </view>
      <view class="stat-card" wx:else>
        <text class="stat-value">{{dashboard.activeRoomCount}}</text>
        <text class="stat-label">开放房间</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{dashboard.usingCount}}</text>
        <text class="stat-label">使用中</text>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">近 30 天使用排行</text>
        <text class="refresh" bindtap="onRefresh" role="button" aria-label="刷新统计数据">刷新</text>
      </view>
      <view wx:if="{{usageRows.length > 0}}">
        <view class="rank-row" wx:for="{{usageRows}}" wx:key="roomId">
          <view class="rank-info">
            <text class="rank-name">{{item.roomName}}</text>
            <text class="rank-meta">{{item.reservationCount}} 次有效预约 · {{item.usedDays}} 天有使用</text>
          </view>
        </view>
      </view>
      <view class="empty" wx:else>近 30 天暂无已通过或已使用预约</view>
    </view>

    <view class="section">
      <text class="section-title">爽约概况</text>
      <view class="summary-line">
        <text>近 30 天爽约总数</text>
        <text class="summary-value danger">{{noshow.totalNoshow}}</text>
      </view>
      <view class="simple-row" wx:for="{{noshow.topNoshowUsers}}" wx:key="id">
        <text>{{item.real_name || item.nickname || item.student_id}}</text>
        <text>{{item.noshow_count}} 次</text>
      </view>
      <view class="empty" wx:if="{{noshow.topNoshowUsers.length === 0}}">暂无爽约记录</view>
    </view>

    <view class="section">
      <text class="section-title">信用分布</text>
      <view class="simple-row" wx:for="{{creditDistribution}}" wx:key="level">
        <text>{{item.level === 'good' ? '良好' : item.level === 'warning' ? '需注意' : item.level === 'restricted' ? '受限' : '封禁'}}</text>
        <text>{{item.count}} 人</text>
      </view>
      <view class="empty" wx:if="{{creditDistribution.length === 0}}">暂无信用分布数据</view>
    </view>
  </block>
</view>
@import "../../styles/admin-management.wxss";
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 30rpx 56rpx;
  background: transparent;
}

.page-header {
  padding: 12rpx 4rpx 28rpx;
}

.page-title {
  display: block;
  color: #1a1a2e;
  font-size: 40rpx;
  font-weight: 700;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b8494;
  font-size: 24rpx;
}

.poster-card,
.state-card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--glass-border);
  border-radius: 20rpx;
  background: var(--glass-bg);
  -webkit-backdrop-filter: var(--glass-blur);
  backdrop-filter: var(--glass-blur);
  box-shadow: var(--glass-shadow), var(--glass-highlight);
}

.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.heading-copy {
  min-width: 0;
  flex: 1;
  padding-right: 18rpx;
}

.poster-title {
  display: block;
  color: #202839;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
}

.applicant {
  display: block;
  margin-top: 8rpx;
  color: #7b8494;
  font-size: 23rpx;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4e8;
  color: #d66a00;
  font-size: 22rpx;
}

.info-grid {
  padding: 10rpx 0 2rpx;
}

.info-row {
  display: flex;
  padding-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.info-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8992a3;
}

.info-value {
  min-width: 0;
  flex: 1;
  color: #374151;
  word-break: break-all;
}

.description {
  white-space: pre-wrap;
}

.actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 24rpx;
}

/* 高度与字号统一由 ui-btn 提供（min-height 96rpx），此处只保留尺寸与配色 */
.action-button,
.retry-button {
  margin: 0;
  border-radius: var(--btn-radius);
}

.action-button {
  width: 200rpx;
}

.processing {
  color: var(--btn-primary-bg);
  font-size: 24rpx;
}

.load-more-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 8rpx 0 24rpx;
}

.load-more-error {
  margin-bottom: 14rpx;
  color: var(--btn-danger-bg);
  font-size: 23rpx;
}

.load-more-button {
  width: 280rpx;
  margin: 0;
  border-radius: var(--btn-radius);
  background: #eaf3fd;
  color: var(--btn-primary-bg);
  font-size: 25rpx;
}

.state-card {
  display: flex;
  min-height: 260rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #7b8494;
  font-size: 26rpx;
  text-align: center;
}

.loading-dot {
  width: 22rpx;
  height: 22rpx;
  margin-bottom: 20rpx;
  border: 5rpx solid #d9e8f8;
  border-top-color: var(--btn-primary-bg);
  border-radius: 50%;
}

.state-title {
  color: #374151;
  font-size: 29rpx;
  font-weight: 600;
}

.state-note {
  margin-top: 10rpx;
  color: #9aa2af;
  font-size: 24rpx;
}

.retry-button {
  width: 220rpx;
  margin-top: 28rpx;
  background: #eaf3fd;
  color: var(--btn-primary-bg);
}


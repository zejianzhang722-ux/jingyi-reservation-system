.page{padding:28rpx;background:#f2f6f8;min-height:100vh;color:#173d4d}.hero{padding:32rpx;background:linear-gradient(135deg,#103e50,#1b766d);border-radius:24rpx;color:#fff}.hero text,.details text,.record text{display:block;margin:14rpx 0}.title{font-size:42rpx;font-weight:700}.card{margin:24rpx 0;padding:28rpx;background:#fff;border-radius:24rpx;box-shadow:0 6rpx 24rpx #1238400a}.subtitle{font-size:32rpx;font-weight:600}button{margin:20rpx 0;font-size:28rpx}button[type=primary]{background:#16756d}textarea,input{box-sizing:border-box;width:100%;background:#f1f6f6;border:1rpx solid #d9e7e5;border-radius:12rpx;padding:18rpx;margin:20rpx 0}textarea{height:140rpx;font-size:26rpx}input{height:88rpx}.message,.warning{padding:20rpx;margin:20rpx 0;background:#e4f5ee;border-radius:12rpx}.warning{background:#fff2e4;color:#9c461d}.details{padding:18rpx;background:#f5f8f8;border-radius:12rpx}.record{border-top:1rpx solid #e1eceb;padding:22rpx 0}.record text{font-size:25rpx;color:#607d85}.filter{padding:20rpx 0;color:#607d85}.pagination{display:flex;align-items:center;justify-content:space-between;font-size:24rpx}
.summary-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:24rpx}.summary-grid>view{background:#fff;border-radius:16rpx;padding:18rpx 10rpx;text-align:center;font-size:22rpx}.summary-grid text{display:block}.summary-grid .stat{font-size:40rpx;font-weight:700;margin-top:8rpx}.summary-grid .wait{background:#fff5df;color:#956417}.summary-grid .present{background:#dcf3e9;color:#166751}.hint{display:block;font-size:23rpx;color:#718b94;margin-top:12rpx}.reservation-filters{display:flex;justify-content:space-between;margin:24rpx 0;font-size:25rpx}.reservation-item{border:1rpx solid #dce7eb;border-left:7rpx solid #b5cad3;padding:24rpx;border-radius:14rpx;margin-top:20rpx;background:#f7fafb}.reservation-item.approved{border-left-color:#d3a640}.reservation-item.checked_in{border-left-color:#319983}.reservation-row{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:14rpx}.reservation-row:first-child{margin-top:0}.number{color:#81959d;font-size:22rpx}.status{font-size:22rpx;background:#eaf1f4;padding:6rpx 12rpx;border-radius:8rpx}.room,.time{display:block;margin-top:16rpx;font-size:32rpx;font-weight:600}.time{font-size:35rpx}.reservation-row .hint{margin-top:0}
/* Senior-friendly: readable text, spacious controls, non-color status labels. */
.page{font-size:34rpx;line-height:1.65}.hero .title{font-size:44rpx}.hero text{margin:12rpx 0}.hero .scope{font-size:38rpx;font-weight:700}.hero text:not(.title):not(.scope){font-size:30rpx}.subtitle{font-size:36rpx}.summary-grid{grid-template-columns:repeat(2,1fr);gap:16rpx}.summary-grid>view{font-size:30rpx;padding:20rpx}.summary-grid .stat{font-size:46rpx}.summary-grid .wait{color:#795010}.summary-grid .present{color:#145c46}.hint,.number,.record text,.filter{font-size:30rpx;color:#405e68}.status{font-size:30rpx;background:#e3edf0;padding:10rpx 14rpx}.room{font-size:38rpx;font-weight:700}.time{font-size:42rpx}.reservation-row{flex-wrap:wrap}.reservation-filters{flex-direction:column;gap:16rpx;font-size:32rpx}.reservation-filters picker{padding:20rpx;background:#eef4f5;border-radius:12rpx;min-height:64rpx}.navigation button{text-align:left;padding:24rpx 28rpx;border:1rpx solid #d2e2e4;border-radius:20rpx;background:#fff;color:#143e4c;font-size:38rpx;font-weight:700;line-height:1.5}.navigation .nav-scan{background:#11665f;color:white}.nav-description{display:block;font-size:30rpx;font-weight:400;margin-top:10rpx}.help{padding:20rpx 8rpx;font-size:30rpx;color:#405e68}button{font-size:34rpx;min-height:96rpx;line-height:1.5;padding:20rpx 16rpx}button[size=mini]{font-size:32rpx;min-height:96rpx}input{height:104rpx;font-size:32rpx}textarea{height:180rpx;font-size:32rpx}.pagination{font-size:30rpx;gap:14rpx;flex-wrap:wrap}.pagination button{flex:1}.warning{font-size:32rpx}.details{font-size:34rpx}checkbox-group label{display:block;padding:24rpx 0;line-height:1.8}

.container {
  min-height: 100vh;
  padding: 20rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f7fa;
}
.admin-header { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0 24rpx; }
.admin-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a2e; }
.admin-subtitle { display: block; margin-top: 8rpx; font-size: 24rpx; color: #7b8494; }
.admin-role { flex-shrink: 0; margin-left: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx; background: #0b63ce; color: #fff; font-size: 24rpx; }
.queue-tabs { display: flex; padding: 8rpx; margin-bottom: 24rpx; border-radius: 16rpx; background: #e9eef5; }
.queue-tab { display: flex; flex: 1; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 12rpx; color: #596579; font-size: 27rpx; font-weight: 600; }
.queue-tab.active { background: #fff; color: #0b63ce; box-shadow: 0 2rpx 10rpx rgba(30, 62, 100, 0.1); }
.priority-note { margin-bottom: 24rpx; padding: 24rpx 28rpx; border-left: 6rpx solid #d98b17; border-radius: 12rpx; background: #fff8e8; }
.priority-note-title { display: block; color: #7a4b08; font-size: 27rpx; font-weight: 700; }
.priority-note-text { display: block; margin-top: 8rpx; color: #7d633c; font-size: 24rpx; line-height: 1.5; }
.scan-checkin-card { display: flex; min-height: 88rpx; align-items: center; gap: 20rpx; margin-bottom: 24rpx; padding: 28rpx 30rpx; border-radius: 20rpx; background: linear-gradient(135deg, #0b63ce, #27b8ff); box-shadow: 0 12rpx 28rpx rgba(0, 102, 204, 0.2); }
.scan-checkin-icon { position: relative; width: 72rpx; height: 72rpx; flex-shrink: 0; border: 4rpx solid rgba(255,255,255,0.95); border-radius: 16rpx; box-sizing: border-box; }
.scan-checkin-icon::before { content: ''; position: absolute; left: 14rpx; right: 14rpx; top: 32rpx; height: 4rpx; border-radius: 4rpx; background: #fff; box-shadow: 0 -16rpx 0 rgba(255,255,255,0.65), 0 16rpx 0 rgba(255,255,255,0.65); }
.scan-checkin-content { flex: 1; min-width: 0; }
.scan-checkin-title { display: block; color: #fff; font-size: 32rpx; font-weight: 700; }
.scan-checkin-desc { display: block; margin-top: 6rpx; color: rgba(255,255,255,0.82); font-size: 23rpx; }
.scan-checkin-status { flex-shrink: 0; padding: 10rpx 18rpx; border-radius: 24rpx; background: #fff; color: #0b63ce; font-size: 23rpx; font-weight: 600; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 16rpx; }
.stat-card { padding: 28rpx 20rpx; border-radius: 16rpx; background: #fff; text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.stat-value { display: block; color: #0b63ce; font-size: 44rpx; font-weight: 700; }
.stat-label { display: block; margin-top: 8rpx; color: #7b8494; font-size: 24rpx; }
.stat-unavailable { display: flex; min-height: 66rpx; align-items: center; justify-content: center; color: #8a5b14; font-size: 25rpx; font-weight: 600; }
.feedback-retry { display: flex; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 12rpx; border: 2rpx solid #b8c2d0; border-radius: 12rpx; background: #fff; color: #425066; font-size: 23rpx; font-weight: 600; }
.stats-message { margin-bottom: 24rpx; padding: 16rpx 20rpx; border-radius: 10rpx; background: #fff4e5; color: #76531b; font-size: 23rpx; line-height: 1.5; }
.stats-retry { display: flex; min-height: 88rpx; align-items: center; justify-content: center; margin-top: 14rpx; border: 2rpx solid #b67b1a; border-radius: 12rpx; background: #fff; color: #76531b; font-weight: 600; }
.trusted-empty { display: block; margin-top: 8rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 0 18rpx; }
.section-title { color: #2b3442; font-size: 30rpx; font-weight: 700; }
.section-count { color: #7b8494; font-size: 24rpx; }
.state-card { padding: 44rpx 28rpx; border-radius: 16rpx; background: #fff; text-align: center; }
.state-title { display: block; color: #2b3442; font-size: 28rpx; font-weight: 600; }
.state-desc { display: block; margin-top: 10rpx; color: #7b8494; font-size: 24rpx; line-height: 1.5; }
.retry-button { display: flex; min-height: 88rpx; align-items: center; justify-content: center; width: 240rpx; margin: 28rpx auto 0; border-radius: 12rpx; background: #0b63ce; color: #fff; font-size: 26rpx; font-weight: 600; }
.pending-list { display: flex; flex-direction: column; gap: 20rpx; }
.pending-item { padding: 28rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.card-topline { display: flex; align-items: flex-start; justify-content: space-between; }
.pending-name { display: block; color: #263141; font-size: 30rpx; font-weight: 700; }
.pending-student { display: block; margin-top: 6rpx; color: #7b8494; font-size: 23rpx; }
.queue-badge { flex-shrink: 0; margin-left: 20rpx; padding: 8rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; font-weight: 600; }
.queue-badge.ordinary { background: #e8f2ff; color: #0b63ce; }
.queue-badge.priority { background: #fff1d7; color: #8b5509; }
.room-line { margin: 24rpx 0 18rpx; padding-bottom: 18rpx; border-bottom: 1rpx solid #edf0f4; }
.pending-room { display: block; color: #343e4d; font-size: 27rpx; font-weight: 600; }
.room-meta { display: block; margin-top: 6rpx; color: #7b8494; font-size: 23rpx; }
.detail-row { display: flex; margin-top: 12rpx; line-height: 1.5; }
.detail-label { width: 128rpx; flex-shrink: 0; color: #7b8494; font-size: 24rpx; }
.detail-value { flex: 1; color: #394454; font-size: 24rpx; word-break: break-all; }
.pending-actions { display: flex; gap: 14rpx; margin-top: 26rpx; }
.btn-approve,
.btn-reject,
.btn-detail { display: flex; min-height: 88rpx; flex: 1; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 12rpx; font-size: 25rpx; font-weight: 600; }
.btn-detail { border: 2rpx solid #b8c2d0; color: #425066; background: #fff; }
.btn-detail.primary { border-color: #0b63ce; background: #0b63ce; color: #fff; }
.btn-approve { background: #237f3d; color: #fff; }
.btn-reject { border: 2rpx solid #cf3f43; background: #fff; color: #b72f34; }
.processing-text { display: flex; min-height: 88rpx; flex: 1; align-items: center; justify-content: center; border-radius: 12rpx; background: #eef2f6; color: #687487; font-size: 24rpx; }

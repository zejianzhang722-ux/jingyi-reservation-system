.container { padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
.manage-header { padding: 10rpx 4rpx 28rpx; }
.manage-title { display: block; font-size: 40rpx; font-weight: 800; color: #172033; }
.manage-subtitle { display: block; margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.menu-section { margin-bottom: 26rpx; }
.section-label { display: block; font-size: 26rpx; color: #536175; font-weight: 700; margin: 0 0 14rpx 4rpx; }
.menu-grid { display: flex; flex-direction: column; gap: 16rpx; }
.menu-card { background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); box-shadow: var(--glass-shadow), var(--glass-highlight); border-radius: 24rpx; padding: 24rpx; display: flex; align-items: center; }
.menu-card:active { background: rgba(0, 102, 204, 0.06); }
.menu-icon { width: 70rpx; height: 70rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 20rpx; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1rpx solid rgba(255, 255, 255, 0.6); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7), 0 4rpx 12rpx rgba(31, 64, 104, 0.08); }
.menu-icon-blue { background: linear-gradient(145deg, rgba(0, 102, 204, 0.14), rgba(0, 102, 204, 0.05)); }
.menu-icon-gold { background: linear-gradient(145deg, rgba(240, 170, 32, 0.18), rgba(240, 170, 32, 0.06)); }
.menu-icon-green { background: linear-gradient(145deg, rgba(47, 138, 59, 0.16), rgba(47, 138, 59, 0.05)); }
.menu-icon-purple { background: linear-gradient(145deg, rgba(139, 92, 246, 0.16), rgba(139, 92, 246, 0.05)); }
.menu-icon-red { background: linear-gradient(145deg, rgba(214, 69, 69, 0.18), rgba(214, 69, 69, 0.06)); }
.menu-icon-cyan { background: linear-gradient(145deg, rgba(15, 181, 181, 0.16), rgba(15, 181, 181, 0.05)); }
.menu-icon-inner { width: 40rpx; height: 40rpx; }
.menu-info { flex: 1; min-width: 0; }
.menu-name { display: block; font-size: 30rpx; color: #172033; font-weight: 700; }
.menu-desc { display: block; font-size: 23rpx; color: #667085; margin-top: 8rpx; line-height: 1.35; }

.menu-icon { position: relative; }
.menu-badge { position: absolute; top: -12rpx; right: -14rpx; min-width: 32rpx; height: 32rpx; padding: 0 7rpx; box-sizing: border-box; border-radius: 18rpx; background: #d92d20; color: #fff; font-size: 20rpx; line-height: 32rpx; text-align: center; box-shadow: 0 2rpx 6rpx rgba(217, 45, 32, 0.3); }

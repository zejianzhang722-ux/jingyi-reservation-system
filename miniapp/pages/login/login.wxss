page { min-height: 100%; background: #061426; }

.login-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(165deg, #07182b 0%, #061426 55%, #04101e 100%);
  color: #f3fbff;
}

.space-backdrop { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .72; }
.backdrop-vignette { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(3,13,25,.08), rgba(4,16,30,.38) 40%, rgba(3,12,23,.94)); }

.space-grid {
  position: absolute;
  left: -12%; right: -12%; bottom: -6%; height: 52%;
  opacity: .13;
  transform: perspective(520rpx) rotateX(58deg);
  transform-origin: center bottom;
  background-image: linear-gradient(rgba(104,222,220,.36) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(104,222,220,.3) 1rpx, transparent 1rpx);
  background-size: 58rpx 58rpx;
  mask-image: linear-gradient(to top, #000 20%, transparent 90%);
}

.ambient-glow { position: absolute; border-radius: 50%; filter: blur(12rpx); pointer-events: none; }
.glow-left { width: 300rpx; height: 300rpx; left: -190rpx; top: 42%; background: rgba(45,189,196,.12); }
.glow-right { width: 260rpx; height: 260rpx; right: -170rpx; bottom: 8%; background: rgba(82,151,222,.1); }

.login-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  animation: brandReveal .85s cubic-bezier(.22,.8,.3,1) both;
}

.brand-kicker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(111,224,221,.22);
  border-radius: 999rpx;
  background: rgba(7,29,49,.44);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.08);
  color: rgba(180,231,232,.78);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.kicker-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #7ce8df; box-shadow: 0 0 14rpx rgba(124,232,223,.85); }

.logo-stage {
  position: relative;
  width: 178rpx;
  height: 178rpx;
  margin: 12rpx 0 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: logoFloat 7s ease-in-out infinite;
}

.brand-logo { position: relative; z-index: 3; width: 156rpx; height: 156rpx; filter: drop-shadow(0 18rpx 25rpx rgba(18,174,197,.28)); }
.logo-orbit { position: absolute; border-radius: 50%; pointer-events: none; }
.orbit-outer { inset: 2rpx; border: 1rpx solid rgba(116,224,221,.2); border-left-color: rgba(245,233,190,.6); transform: rotate(-18deg) scaleY(.38); animation: orbitTurn 12s linear infinite; }
.orbit-inner { inset: 20rpx; border: 1rpx solid rgba(174,244,242,.12); box-shadow: 0 0 34rpx rgba(78,211,211,.11), inset 0 0 26rpx rgba(83,219,213,.08); }
.logo-sheen { position: absolute; z-index: 4; top: 30rpx; left: 48rpx; width: 70rpx; height: 14rpx; border-radius: 50%; background: rgba(255,255,255,.34); filter: blur(8rpx); transform: rotate(-28deg); animation: sheenPulse 5.5s ease-in-out infinite; }

.brand-title { font-family: "STKaiti", "KaiTi", serif; font-size: 46rpx; line-height: 1.15; font-weight: 700; letter-spacing: 9rpx; text-shadow: 0 8rpx 24rpx rgba(0,0,0,.38); }
.brand-subtitle { margin-top: 8rpx; color: rgba(216,237,244,.82); font-size: 24rpx; font-weight: 600; letter-spacing: 6rpx; }
.brand-divider { width: 126rpx; height: 1rpx; margin: 14rpx 0 12rpx; background: linear-gradient(90deg, transparent, rgba(112,226,221,.65), transparent); display: flex; justify-content: center; }
.brand-divider view { width: 22rpx; height: 3rpx; margin-top: -1rpx; border-radius: 4rpx; background: #7ce8df; box-shadow: 0 0 12rpx rgba(124,232,223,.7); }
.brand-desc { color: rgba(170,198,211,.68); font-size: 21rpx; letter-spacing: 4rpx; }

.login-card {
  width: 100%;
  max-width: 650rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 30rpx 30rpx 24rpx;
  border: 1rpx solid rgba(151,231,231,.2);
  border-radius: 32rpx;
  background: linear-gradient(145deg, rgba(16,45,70,.88), rgba(6,25,44,.82));
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.12), inset 0 -1rpx 0 rgba(51,174,185,.08), 0 30rpx 70rpx rgba(0,7,17,.42);
  animation: cardReveal .8s .14s cubic-bezier(.22,.8,.3,1) both;
}

.card-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24rpx; }
.card-eyebrow, .card-title { display: block; }
.card-eyebrow { color: #6edbd7; font-size: 17rpx; font-weight: 700; letter-spacing: 4rpx; }
.card-title { margin-top: 7rpx; color: #f1fbff; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.secure-badge { display: flex; align-items: center; gap: 8rpx; padding: 9rpx 12rpx; border-radius: 999rpx; background: rgba(72,184,176,.09); color: rgba(172,225,221,.72); font-size: 18rpx; }
.secure-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #77dfb8; box-shadow: 0 0 10rpx rgba(119,223,184,.7); }

.tab-bar { display: flex; position: relative; margin-bottom: 26rpx; padding: 6rpx; border: 1rpx solid rgba(152,213,220,.1); border-radius: 18rpx; background: rgba(2,18,33,.48); }
.tab-item { position: relative; z-index: 2; flex: 1; padding: 17rpx 0; border-radius: 13rpx; color: rgba(173,198,210,.55); font-size: 26rpx; font-weight: 600; text-align: center; transition: color .28s ease; }
.tab-active { color: #052439; font-weight: 800; }
.tab-indicator { position: absolute; z-index: 1; top: 6rpx; left: 6rpx; width: calc(50% - 6rpx); height: calc(100% - 12rpx); border-radius: 13rpx; background: linear-gradient(105deg, #70e1dc, #67cfd5 50%, #79e4c8); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.62), 0 8rpx 22rpx rgba(42,190,192,.2); transition: transform .3s cubic-bezier(.22,.8,.3,1); }

.form-section { animation: formReveal .34s ease-out both; }
.field-shell { margin-bottom: 20rpx; }
.field-label { display: block; margin: 0 0 10rpx 4rpx; color: rgba(209,231,238,.76); font-size: 21rpx; font-weight: 600; letter-spacing: 1rpx; }

.input-group {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(143,207,216,.16);
  border-radius: 18rpx;
  background: rgba(3,20,36,.48);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.04);
  transition: border-color .24s ease, box-shadow .24s ease, background .24s ease;
}
.input-group:focus-within { border-color: rgba(108,224,219,.72); background: rgba(5,28,47,.72); box-shadow: 0 0 0 5rpx rgba(94,213,210,.07), inset 0 1rpx 0 rgba(255,255,255,.06); }

.input-icon { position: relative; width: 38rpx; height: 38rpx; margin-right: 18rpx; flex-shrink: 0; color: #63d6d5; }
.input-icon::before, .input-icon::after { content: ""; position: absolute; box-sizing: border-box; }
.input-icon-user::before { left: 12rpx; top: 3rpx; width: 14rpx; height: 14rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.input-icon-user::after { left: 5rpx; bottom: 2rpx; width: 28rpx; height: 15rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 18rpx 18rpx 0 0; }
.input-icon-card::before { left: 3rpx; top: 7rpx; width: 32rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 6rpx; }
.input-icon-card::after { left: 8rpx; top: 15rpx; width: 22rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; }
.input-icon-lock::before { left: 6rpx; bottom: 2rpx; width: 27rpx; height: 23rpx; border: 3rpx solid currentColor; border-radius: 7rpx; }
.input-icon-lock::after { left: 11rpx; top: 1rpx; width: 17rpx; height: 18rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 12rpx 12rpx 0 0; }

.form-input { flex: 1; height: 96rpx; color: #f1fbff; font-size: 27rpx; caret-color: #70e1dc; }
.action-section { margin-top: 8rpx; }
.login-btn { width: 100%; height: 94rpx; line-height: 94rpx; margin: 0; border: 0; border-radius: 20rpx; background: linear-gradient(105deg, #69dce0, #5fcdd1 47%, #78dfbc); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.7), 0 14rpx 30rpx rgba(48,191,192,.22); color: #04263a; font-size: 29rpx; font-weight: 800; letter-spacing: 3rpx; transition: transform .16s ease, box-shadow .16s ease, filter .16s ease; }
.login-btn::after { border: 0; }
.login-btn:active { transform: translateY(2rpx) scale(.985); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.58), 0 7rpx 18rpx rgba(48,191,192,.18); filter: brightness(.94); }
.login-btn[disabled] { opacity: .58; background: linear-gradient(105deg, #5e8790, #597c84); color: rgba(232,246,248,.76); }

.trust-row { display: flex; align-items: center; justify-content: center; margin-top: 20rpx; color: rgba(151,186,199,.6); font-size: 18rpx; }
.trust-item { display: flex; align-items: center; gap: 8rpx; }
.trust-mark { width: 8rpx; height: 8rpx; border: 2rpx solid rgba(105,215,208,.58); border-radius: 50%; }
.trust-separator { width: 1rpx; height: 19rpx; margin: 0 22rpx; background: rgba(151,186,199,.18); }

.footer-text { display: flex; flex-direction: column; align-items: center; gap: 10rpx; margin-top: 25rpx; color: rgba(166,194,205,.66); font-size: 20rpx; letter-spacing: 1rpx; animation: cardReveal .8s .25s ease-out both; }
.footer-version { color: rgba(110,219,215,.38); font-size: 15rpx; font-weight: 700; letter-spacing: 5rpx; }

@keyframes brandReveal { from { opacity: 0; transform: translateY(-18rpx) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes cardReveal { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes formReveal { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes logoFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
@keyframes orbitTurn { from { transform: rotate(-18deg) scaleY(.38); } to { transform: rotate(342deg) scaleY(.38); } }
@keyframes sheenPulse { 0%, 100% { opacity: .34; transform: translate(-5rpx,3rpx) rotate(-28deg); } 50% { opacity: .72; transform: translate(20rpx,-7rpx) rotate(-28deg); } }

@media (max-height: 720px) {
  .login-content { padding-top: 20rpx; }
  .logo-stage { width: 150rpx; height: 150rpx; margin-top: 6rpx; }
  .brand-logo { width: 134rpx; height: 134rpx; }
  .brand-title { font-size: 40rpx; }
  .brand-divider { margin: 10rpx 0 8rpx; }
  .login-card { margin-top: 18rpx; padding-top: 25rpx; }
}

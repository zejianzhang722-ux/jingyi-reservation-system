<view class="container reservation-page">
  <view class="rules-modal" wx:if="{{showRulesModal}}">
    <view class="rules-modal-mask" catchtouchmove="preventBackgroundScroll"></view>
    <view class="rules-modal-content">
      <view class="rules-modal-header">
        <text class="rules-modal-title">功能房管理制度</text>
      </view>
      <scroll-view class="rules-modal-body" scroll-y enhanced show-scrollbar="{{true}}" bindscrolltolower="onRulesScrollToLower">
        <view class="rule-section" wx:for="{{rulesSections}}" wx:key="index" wx:for-item="section"><text class="rule-section-title" wx:if="{{section.title}}">{{section.title}}</text><view class="rule-point" wx:for="{{section.items}}" wx:key="index" wx:for-item="point"><text class="rule-point-dot">•</text><text>{{point}}</text></view></view>
        <view style="height: 20px;"></view>
      </scroll-view>
      <view class="rules-modal-footer">
        <view class="rules-agree-row" bindtap="onRulesAgreeChange">
          <view class="rules-checkbox {{rulesAgreed ? 'rules-checkbox-checked' : ''}}"></view>
          <text class="rules-agree-text">我已知悉上述管理制度并遵守相关规定</text>
        </view>
        <view class="rules-btn-row">
          <view class="rules-btn rules-btn-cancel" bindtap="onRulesCancel">返回</view>
          <view class="rules-btn rules-btn-confirm {{rulesAgreed ? '' : 'rules-btn-disabled'}}" bindtap="onRulesConfirm">
            {{rulesCountdown > 0 ? '请阅读(' + rulesCountdown + 's)' : '确认进入'}}
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="room-header motion-page motion-stack" wx:if="{{room}}">
    <view class="room-header-info">
      <text class="room-header-name">{{room.name}}</text>
      <view class="room-header-stats">
        <text class="stat-item">座位 {{totalCount}}</text>
        <text class="stat-divider">|</text>
        <text class="stat-item stat-free">空闲 {{freeCount}}</text>
      </view>
    </view>
  </view>

  <date-picker days="{{4}}" selectedDate="{{selectedDate}}" bind:change="onDateChange"></date-picker>

  <view class="timeline-section" wx:if="{{!loading}}">
    <view class="timeline-tip"><text>上下选座 · 左右看时间 · 点击空闲时段</text></view>
    <view class="timeline-viewport">
    <timeline style="display:block;height:100%" seats="{{seats}}" timeline="{{timeline}}" myReservations="{{myReservations}}"
              openHour="{{openHour}}" closeHour="{{closeHour}}" maxHours="{{maxHours}}"
              mode="seat" isToday="{{isToday}}" bind:selecttime="onTimelineSelect">
    </timeline>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="time-picker-mask" wx:if="{{showTimePicker}}" bindtap="onCancelTime" catchtouchmove="preventBackgroundScroll"></view>
  <view wx:if="{{showTimePicker}}" class="time-picker time-picker-show" catchtouchmove="preventBackgroundScroll">
    <view class="time-picker-handle"></view>
    <view class="time-picker-header">
      <text class="time-picker-title">选择时间段</text>
      <view class="time-picker-close" bindtap="onCancelTime" role="button" aria-label="关闭时间选择">✕</view>
    </view>
    <scroll-view class="time-picker-body" scroll-y>
      <view class="time-picker-context">
        <text class="time-picker-room">{{room.name}}{{selectedSeatName ? ' · ' + selectedSeatName : ''}}</text>
        <text class="time-picker-date">{{selectedDate}} · 最长 {{maxHours}} 小时</text>
      </view>
      <view class="time-picker-row">
        <text class="time-picker-label">开始时间</text>
        <picker mode="selector" range="{{startHourList}}" value="{{startHourIndex}}" bindchange="onStartHourChange">
          <text class="time-picker-value">{{selectedStartTimeStr}}</text>
        </picker>
      </view>
      <view class="time-picker-row">
        <text class="time-picker-label">结束时间</text>
        <picker mode="selector" range="{{endHourList}}" value="{{endHourIndex}}" bindchange="onEndHourChange">
          <text class="time-picker-value">{{selectedEndTimeStr}}</text>
        </picker>
      </view>
      <view class="time-picker-duration">
        <text class="duration-text">时长: {{durationStr}}</text>
      </view>
    </scroll-view>
    <view class="time-picker-footer">
      <view class="time-picker-btn btn-cancel" bindtap="onCancelTime">取消</view>
      <view class="time-picker-btn btn-confirm" bindtap="onConfirmTime">确认</view>
    </view>
  </view>
</view>

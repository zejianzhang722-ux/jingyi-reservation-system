<view class="container motion-page motion-tab {{pageMotionActive ? 'motion-active' : ''}}">
  <view class="profile-header">
    <view class="avatar-wrap"><view class="avatar-icon">{{avatarInitial}}</view></view>
    <view class="profile-info">
      <text class="profile-name">{{adminInfo.name || adminInfo.realName || adminInfo.real_name || adminInfo.username || '管理员'}}</text>
      <text class="profile-role">{{roleLabel || '管理员'}}</text>
    </view>
  </view>

  <view class="notice-card">
    <text class="notice-title">账号与设置</text>
    <text class="notice-desc">查看当前账号信息、连接状态和安全说明</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="key" data-key="{{item.key}}" bindtap="onMenuTap">
      <view class="menu-icon menu-icon-{{item.tone}}"><view class="icon menu-icon-inner icon-{{item.icon}}"></view></view>
      <view class="menu-info"><text class="menu-name">{{item.name}}</text><text class="menu-desc">{{item.desc}}</text></view>
      <view class="icon icon-chevron menu-arrow-icon"></view>
    </view>
  </view>
</view>
<admin-nav selected="profile"></admin-nav>

<app-dialog id="app-dialog" />

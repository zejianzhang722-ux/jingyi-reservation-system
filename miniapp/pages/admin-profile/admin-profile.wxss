.container { padding: 0 0 calc(180rpx + env(safe-area-inset-bottom)); min-height: 100vh; box-sizing: border-box; }
.profile-header { background: linear-gradient(135deg, #0066cc, #004c99); padding: 48rpx 32rpx; display: flex; align-items: center; border-radius: 0 0 30rpx 30rpx; }
.avatar-wrap { margin-right: 24rpx; }
.avatar-icon { width: 104rpx; height: 104rpx; border-radius: 50%; background: rgba(255,255,255,0.2); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 42rpx; font-weight: 800; border: 3rpx solid rgba(255,255,255,0.42); }
.profile-info { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: 38rpx; font-weight: bold; color: #fff; margin-bottom: 10rpx; }
.profile-role { display: inline-block; font-size: 24rpx; color: rgba(255,255,255,0.9); background: rgba(255,255,255,0.16); padding: 6rpx 16rpx; border-radius: 14rpx; }
.notice-card { margin: -20rpx 24rpx 22rpx; background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); box-shadow: var(--glass-shadow), var(--glass-highlight); border-radius: 24rpx; padding: 24rpx; position: relative; z-index: 1; }
.notice-title { display: block; font-size: 28rpx; color: #172033; font-weight: 700; }
.notice-desc { display: block; margin-top: 8rpx; color: #667085; font-size: 24rpx; line-height: 1.5; }
.menu-list { margin: 0 24rpx; background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur); border: 1rpx solid var(--glass-border); box-shadow: var(--glass-shadow), var(--glass-highlight); border-radius: 24rpx; overflow: hidden; }
.menu-item { display: flex; align-items: center; padding: 26rpx 28rpx; border-bottom: 1rpx solid rgba(31, 64, 104, 0.06); }
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: rgba(0, 102, 204, 0.06); }
.menu-icon { width: 58rpx; height: 58rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border: 1rpx solid rgba(255, 255, 255, 0.6); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7), 0 4rpx 12rpx rgba(31, 64, 104, 0.08); }
.menu-icon-blue { background: linear-gradient(145deg, rgba(0, 102, 204, 0.14), rgba(0, 102, 204, 0.05)); }
.menu-icon-purple { background: linear-gradient(145deg, rgba(139, 92, 246, 0.16), rgba(139, 92, 246, 0.05)); }
.menu-icon-gold { background: linear-gradient(145deg, rgba(240, 170, 32, 0.18), rgba(240, 170, 32, 0.06)); }
.menu-icon-cyan { background: linear-gradient(145deg, rgba(15, 181, 181, 0.16), rgba(15, 181, 181, 0.05)); }
.menu-icon-red { background: linear-gradient(145deg, rgba(214, 69, 69, 0.18), rgba(214, 69, 69, 0.06)); }
.menu-icon-inner { width: 36rpx; height: 36rpx; }
.menu-info { flex: 1; min-width: 0; }
.menu-name { display: block; font-size: 29rpx; color: #172033; font-weight: 700; }
.menu-desc { display: block; margin-top: 6rpx; font-size: 23rpx; color: #667085; }
.menu-arrow-icon { width: 30rpx; height: 30rpx; opacity: 0.45; margin-left: 18rpx; flex-shrink: 0; }

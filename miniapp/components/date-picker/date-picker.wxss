.date-picker {
  width: 100%;
  white-space: nowrap;
  padding: 16rpx 0;
}

.date-picker-inner {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 16rpx;
}

.date-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-lg);
  background: var(--glass-bg-soft);
  border: 1rpx solid var(--glass-border-soft);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  min-width: 120rpx;
  transition: all 0.2s ease;
}

.date-item-active {
  background: linear-gradient(135deg, #3385E6, #0066CC);
  border-color: transparent;
  box-shadow: 0 6rpx 18rpx rgba(0, 102, 204, 0.35);
}

.date-weekday {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.date-item-active .date-weekday {
  color: rgba(255, 255, 255, 0.8);
}

.date-display {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.date-item-active .date-display {
  color: #FFFFFF;
}

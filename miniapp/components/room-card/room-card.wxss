.room-card {
  display: flex;
  flex-direction: row;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin: 12rpx 24rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
}

.room-card-status-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.room-card-content {
  flex: 1;
  padding: 24rpx;
}

.room-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.room-card-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(31, 64, 104, 0.18), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
  flex-shrink: 0;
}

.room-card-info {
  display: flex;
  flex-direction: column;
}

.room-card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.room-card-number {
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 4rpx;
}

.room-card-footer {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.room-card-rate {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.room-card-rate-label {
  font-size: 24rpx;
  color: var(--text-hint);
}

.room-card-rate-value {
  font-size: 28rpx;
  font-weight: bold;
}

.room-card-status-text {
  font-size: 24rpx;
  font-weight: bold;
}

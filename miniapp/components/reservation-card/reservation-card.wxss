.reservation-card {
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1rpx solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin: 12rpx 24rpx;
  box-shadow: var(--glass-shadow), var(--glass-highlight);
}

.reservation-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.reservation-card-room {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.reservation-card-room-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.reservation-card-room-number {
  font-size: 24rpx;
  color: var(--text-hint);
}

.reservation-card-body {
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.5);
}

.reservation-card-info-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.reservation-card-label {
  font-size: 26rpx;
  color: var(--text-hint);
}

.reservation-card-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.reservation-card-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
}

.reservation-card-action {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  text-align: center;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

.reservation-card-action:active {
  transform: scale(0.95);
  opacity: 0.85;
}

.btn-cancel {
  background-color: var(--danger-light);
  color: var(--danger);
  border: 1rpx solid rgba(255, 77, 79, 0.4);
}

.btn-checkin {
  background: linear-gradient(135deg, #3385E6, #0066CC);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(0, 102, 204, 0.3);
}

.btn-qrcode {
  background-color: var(--success-light);
  color: var(--success);
  border: 1rpx solid rgba(82, 196, 26, 0.4);
}

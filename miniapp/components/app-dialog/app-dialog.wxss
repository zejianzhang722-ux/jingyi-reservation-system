.dialog-overlay{position:fixed;inset:0;z-index:10000;background:rgba(12,30,54,.48);display:flex;align-items:flex-end;padding:24rpx;box-sizing:border-box}.dialog-panel{width:100%;background:#fff;border-radius:32rpx;padding:32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));box-sizing:border-box;box-shadow:0 20rpx 80rpx rgba(10,30,60,.2);max-height:90vh}.dialog-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:26rpx}.dialog-kicker{display:block;font-size:22rpx;color:#7c8da2;letter-spacing:3rpx;margin-bottom:10rpx}.dialog-title{display:block;font-size:36rpx;font-weight:700;color:#142c49}.dialog-close{margin:0;width:72rpx;height:72rpx;line-height:64rpx;background:#f1f5fa;border-radius:50%;font-size:42rpx;color:#58708c;padding:0}.dialog-close::after{border:0}.dialog-body{max-height:56vh}.dialog-copy{display:block;font-size:28rpx;color:#52657c;line-height:1.8;white-space:pre-wrap;margin-bottom:24rpx}.dialog-section{padding:22rpx;background:#f5f8fc;border-radius:20rpx;margin-bottom:16rpx}.dialog-section-title{display:block;font-size:29rpx;font-weight:700;color:#173d69;margin-bottom:14rpx}.dialog-point{display:flex;gap:12rpx;margin:10rpx 0;font-size:27rpx;line-height:1.75;color:#43566f}.point-dot{color:#0877d9;flex-shrink:0}.dialog-select{display:flex;justify-content:space-between;align-items:center;min-height:88rpx;background:#f3f6fb;border:2rpx solid #e4ebf4;border-radius:16rpx;padding:0 24rpx;font-size:28rpx;color:#294665}.field-label{display:block;font-size:27rpx;font-weight:600;color:#29435f;margin:18rpx 0 12rpx}.field-required{font-size:21rpx;font-weight:400;color:#dc4545;margin-left:10rpx}.dialog-textarea{width:100%;height:180rpx;background:#f5f8fc;border:2rpx solid #e2eaf5;border-radius:16rpx;padding:22rpx;box-sizing:border-box;font-size:28rpx;line-height:1.65}.dialog-input{min-height:88rpx;padding:0 24rpx;border-radius:16rpx;background:#f5f8fc;border:2rpx solid #e2eaf5;font-size:28rpx}.field-hint{display:block;font-size:22rpx;color:#8b98aa;margin-top:10rpx}.dialog-error{display:block;font-size:25rpx;color:#c93636;margin:16rpx 0}.dialog-actions{display:flex;gap:18rpx;padding-top:24rpx;border-top:2rpx solid #eff3f8;margin-top:18rpx}.dialog-actions button{flex:1;min-height:88rpx;font-size:29rpx;border-radius:18rpx;margin:0}.dialog-actions .ui-btn-primary{background:#066bd0;color:#fff}.dialog-actions .ui-btn-secondary{background:#edf3fb;color:#315475}.dialog-actions button::after{border:0}.dialog-actions button[disabled]{opacity:.55}

.dialog-image{width:100%;border-radius:18rpx;display:block;margin-bottom:22rpx}

.dialog-input{width:100%;height:88rpx;box-sizing:border-box}.dialog-body{box-sizing:border-box;padding-right:4rpx}
